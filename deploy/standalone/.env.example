# Telegram Bot API
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=-1001234567890

# Dead man's switch URL (healthchecks.io, cronitor, ...)
# Leave empty to disable heartbeat.
HEARTBEAT_URL=

# Tokens for authenticated checks (referenced in config.yaml via ${API_TOKEN})
API_TOKEN=

# Bearer token protecting pingbot's own /api/* endpoints.
# Leave empty to keep them open (internal network only).
PINGBOT_API_TOKEN=

# Only for storage.driver: postgres
# DATABASE_URL=postgres://pingbot:pingbot@postgres:5432/pingbot?sslmode=require
